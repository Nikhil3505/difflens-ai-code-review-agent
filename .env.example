# DiffLens Environment Configuration (Optional)
# If left empty, DiffLens runs in offline Grounded AST & Rule Engine mode with zero API keys needed.

# Google Gemini API Key (optional)
GEMINI_API_KEY=

# OpenAI API Key (optional)
OPENAI_API_KEY=

# Custom / Ollama Base URL (optional)
# OPENAI_BASE_URL=http://localhost:11434/v1
